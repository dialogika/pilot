{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/home.html",
        "destination": "/home",
        "type": 301
      },
      {
        "source": "/register.html",
        "destination": "/register",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/login",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/pages/login/index.html"
      },
      {
        "source": "/test",
        "destination": "/pages/test/index.html"
      },
      {
        "source": "/register",
        "destination": "/pages/register/index.html"
      },
      {
        "source": "/home",
        "destination": "/pages/home/index.html"
      },
      {
        "source": "/internships",
        "destination": "/pages/internships/index.html"
      },
      {
        "source": "/hr/performance-appraisal",
        "destination": "/pages/hr/performance-appraisal/index.html"
      },
      {
        "source": "/hr/performance-appraisal/form",
        "destination": "/pages/hr/performance-appraisal/form.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/login",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5000
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}

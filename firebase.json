{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/home.html",
        "destination": "/home",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/test",
        "destination": "/pages/test/index.html"
      },
      {
        "source": "/home",
        "destination": "/pages/home/index.html"
      },
      {
        "source": "/quest",
        "destination": "/pages/quest/index.html"
      },
      {
        "source": "/internships",
        "destination": "/pages/internships/index.html"
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5000
    }
  }
}
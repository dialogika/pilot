{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/home.html",
        "destination": "/home",
        "type": 301
      },
      {
        "source": "/register.html",
        "destination": "/register",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/login",
        "type": 301
      },
      {
        "source": "/data/company-position.html",
        "destination": "/company-position",
        "type": 301
      },
      {
        "source": "/data/candidate-management.html",
        "destination": "/candidate-management",
        "type": 301
      },
      {
        "source": "/data/internship-candidate-detail.html",
        "destination": "/internship-candidate-detail",
        "type": 301
      },
      {
        "source": "/data/mentor-candidate-detail.html",
        "destination": "/mentor-candidate-detail",
        "type": 301
      },
      {
        "source": "/data/team-candidate-detail.html",
        "destination": "/team-candidate-detail",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/candidate-management",
        "destination": "/pages/hr/candidate-management/index.html"
      },
      {
        "source": "/hr/candidate-management",
        "destination": "/pages/hr/candidate-management/index.html"
      },
      {
        "source": "/internship-candidate-detail",
        "destination": "/data/internship-candidate-detail.html"
      },
      {
        "source": "/mentor-candidate-detail",
        "destination": "/data/mentor-candidate-detail.html"
      },
      {
        "source": "/team-candidate-detail",
        "destination": "/data/team-candidate-detail.html"
      },
      {
        "source": "/login",
        "destination": "/pages/login/index.html"
      },
      {
        "source": "/test",
        "destination": "/pages/test/index.html"
      },
      {
        "source": "/register",
        "destination": "/pages/register/index.html"
      },
      {
        "source": "/home",
        "destination": "/pages/home/index.html"
      },
      {
        "source": "/internships",
        "destination": "/pages/internships/index.html"
      },
      {
        "source": "/users-management",
        "destination": "/pages/hr/users-management/index.html"
      },
      {
        "source": "/performance-appraisal",
        "destination": "/pages/hr/performance-appraisal/index.html"
      },
      {
        "source": "/performance-appraisal/form",
        "destination": "/pages/hr/performance-appraisal/form.html"
      },
      {
        "source": "/office-inventory",
        "destination": "/pages/hr/office-inventory/index.html"
      },
      {
        "source": "/inventory",
        "destination": "/pages/hr/office-inventory/index.html"
      },
      {
        "source": "/company-position",
        "destination": "/pages/hr/company-position/index.html"
      },
      {
        "source": "/positions",
        "destination": "/pages/hr/company-position/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/login",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5000
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}

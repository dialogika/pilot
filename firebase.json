{
  "hosting": {
    "public": ".",
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/intern-presence/",
        "destination": "/intern-presence",
        "type": 301
      },
      {
        "source": "/home.html",
        "destination": "/home",
        "type": 301
      },
      {
        "source": "/register.html",
        "destination": "/register",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/login",
        "type": 301
      },
      {
        "source": "/internships",
        "destination": "/internship-management",
        "type": 301
      },
      {
        "source": "/data/intern-presence.html",
        "destination": "/intern-presence",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/pages/login/index.html"
      },
      {
        "source": "/test",
        "destination": "/pages/test/index.html"
      },
      {
        "source": "/register",
        "destination": "/pages/register/index.html"
      },
      {
        "source": "/home",
        "destination": "/pages/home/index.html"
      },
      {
        "source": "/internship-management",
        "destination": "/pages/internships/index.html"
      },
      {
        "source": "/users-management",
        "destination": "/pages/hr/users-management/index.html"
      },
      {
        "source": "/performance-appraisal",
        "destination": "/pages/hr/performance-appraisal/index.html"
      },
      {
        "source": "/performance-appraisal/form",
        "destination": "/pages/hr/performance-appraisal/form.html"
      },
      {
        "source": "/office-inventory",
        "destination": "/pages/hr/office-inventory/index.html"
      },
      {
        "source": "/people-development",
        "destination": "/pages/hr/people-development/index.html"
      },
      {
        "source": "/intern-presence",
        "destination": "/data/intern-presence.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/login",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5000
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}

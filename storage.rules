rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Izin upload foto bukti transfer member
    match /member-proofs/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // Aturan umum file lainnya untuk tim yang sudah login
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // HELPERS
    // -------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() ? request.auth.token.role : null;
    }

    function isStaff() { return role() == 'staff'; }
    function isMentor() { return role() == 'mentor'; }
    function isMember() { return role() == 'member'; }

    // "Manajemen" = semua role internal yang login
    function isManagement() {
      return isSignedIn();
    }

    // "Internal" = seluruh pengguna yang login
    function isInternalTeam() {
      return isSignedIn();
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function myDepartment() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('employment', {}).get('department', null)
        : null;
    }

    function hasSharedAccess(collectionName, mode) {
      let cfg = get(/databases/$(database)/documents/collection_access/$(collectionName)).data;
      return mode == 'read'
        ? myDepartment() in cfg.get('shared_read_departments', [])
        : myDepartment() in cfg.get('shared_write_departments', []);
    }

    // -------------------------------------------------------------------
    // IDENTITY & PRESENCE
    // -------------------------------------------------------------------

    // users: Izinkan publik membaca data profil untuk kebutuhan terminal presensi & pemilihan nama
    match /users/{uid} {
      allow read: if true; 
      allow create: if false;
      allow update: if isSelf(uid) || isManagement();
      allow delete: if isManagement();
    }

    // user_attendance: Izinkan pencatatan & pengecekan presensi masuk/keluar dari kiosk kantor/NFC
    match /user_attendance/{id} {
      allow read, create: if true;
      allow update, delete: if isSelf(resource.data.get('user_id', '')) || isManagement();
    }

    match /pending_users/{id} {
      allow read: if isManagement();
      allow create: if true; // form registrasi publik, sebelum login
      allow update, delete: if isManagement();
    }

    match /roles/{roleId} {
      allow read: if isInternalTeam();
      allow write: if isManagement();
    }

    match /tools/{toolId} {
      allow read: if isInternalTeam();
      allow write: if isManagement();
    }

    match /collection_access/{collectionName} {
      allow read: if isInternalTeam();
      allow write: if isManagement();
    }

    match /positions/{id} {
      allow read: if true; // Diizinkan publik untuk form registrasi
      allow write: if isManagement();
    }

    match /position/{id} {
      allow read: if true; // Fallback koleksi nama tunggal
      allow write: if isManagement();
    }

    match /departments/{id} {
      allow read: if isInternalTeam();
      allow write: if isManagement();
    }

    match /user_presence/{uid} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid);
    }

    // -------------------------------------------------------------------
    // QUEST SYSTEM
    // -------------------------------------------------------------------
    match /quests/{questId} {
      allow read: if isManagement()
                  || (isSignedIn() && request.auth.uid in resource.data.get('assign_to', []))
                  || (isSignedIn() && request.auth.uid in resource.data.get('report_to', []))
                  || (isSignedIn() && resource.data.get('created_by', '') == request.auth.uid);
      allow create: if isInternalTeam();
      allow update: if (isManagement()
                  || (isSignedIn() && request.auth.uid in resource.data.get('assign_to', []))
                  || (isSignedIn() && resource.data.get('created_by', '') == request.auth.uid))
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['difficulty', 'points']);
      allow delete: if isManagement()
              || (isSignedIn() && resource.data.get('created_by', '') == request.auth.uid);

      match /logs/{logId} {
        allow read: if isManagement()
                    || (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/quests/$(questId)).data.get('assign_to', []));
        allow write: if false;
      }
    }

    match /recurrence_templates/{id} {
      allow read: if isInternalTeam();
      allow write: if isManagement();
    }

    match /user_scores/{uid} {
      allow read: if isInternalTeam();
      allow write: if false;
    }
    match /user_scores_history/{id} {
      allow read: if isInternalTeam();
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if isManagement()
                  || (isSignedIn() && request.auth.uid in resource.data.get('members', []));
      allow write: if isManagement()
                   || (isSignedIn() && request.auth.uid in resource.data.get('members', []));

      match /{subcollection}/{docId} {
        allow read, write: if isManagement()
                            || (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.get('members', []));
      }
    }

    // -------------------------------------------------------------------
    // NOTIFICATIONS
    // -------------------------------------------------------------------
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // HR / INTERNSHIP
    // -------------------------------------------------------------------
    match /talents/{id} { allow read, write: if isManagement(); }
    match /interns_screening/{id} { allow read, write: if isManagement(); }
    match /teams_screening/{id} { allow read, write: if isManagement(); }
    match /team_screening/{id} { allow read, write: if isManagement(); }
    match /teams_screening_trash/{id} { allow read, write: if isManagement(); }
    match /mentors_screening_trash/{id} { allow read, write: if isManagement(); }
    match /interns_screening_trash/{id} { allow read, write: if isManagement(); }

    match /mentors_screening/{id} {
      allow read: if isManagement() || (isStaff() && hasSharedAccess('mentors_screening', 'read'));
      allow write: if isManagement() || (isStaff() && hasSharedAccess('mentors_screening', 'write'));
    }

    match /interns_resume/{id} {
      allow read: if isManagement() || isSelf(resource.data.get('user_id', ''));
      allow write: if isManagement();
    }
    match /recruitment_positions/{id} {
      allow read: if isInternalTeam();
      allow write: if isManagement();
    }
    match /recruitment_dashboard_notes/{id} { allow read, write: if isManagement(); }
    match /team_management/{id} { allow read, write: if isManagement(); }

    match /permits/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSelf(resource.data.get('user_id', '')) || isManagement();
    }
    match /reimburse/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSelf(resource.data.get('user_id', '')) || isManagement();
    }
    match /operational_expenses/{id} { allow read, write: if isManagement(); }
    match /duty_schedules/{id} { allow read: if isInternalTeam(); allow write: if isManagement(); }
    match /duty_types/{id} { allow read: if isInternalTeam(); allow write: if isManagement(); }
    
    match /exit_interviews/{id} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------------
    // DAILY REPORT
    // -------------------------------------------------------------------
    match /intern_dailyreport/{id} {
      allow read: if isManagement() || (isInternalTeam() && isSelf(resource.data.get('user_id', '')));
      allow create: if isInternalTeam() && (isSelf(request.resource.data.get('user_id', '')) || isManagement());
      allow update: if isManagement() || (isInternalTeam() && isSelf(resource.data.get('user_id', '')) && resource.data.get('status', '') == 'Pending Review');
      allow delete: if isManagement();
    }

    // -------------------------------------------------------------------
    // SALES / CRM
    // -------------------------------------------------------------------
    match /leads/{id} {
      allow read: if isManagement()
                  || (isStaff() && resource.data.get('assigned_to', '') == request.auth.uid);
      allow write: if isManagement() || isStaff();
    }
    match /leads_settings_interests/{id} { allow read: if isInternalTeam(); allow write: if isManagement(); }
    match /leads_settings_ads_channels/{id} { allow read: if isInternalTeam(); allow write: if isManagement(); }
    match /invoices/{id} { allow read, write: if isManagement(); }
    match /enrollments/{id} {
      allow read: if isManagement() || isStaff()
                  || (isMember() && resource.data.get('member_id', '') == request.auth.uid);
      allow write: if isManagement() || isStaff();
    }

    // -------------------------------------------------------------------
    // CLASS / MENTOR / PRODUCTS
    // -------------------------------------------------------------------
    match /products/{id} {
      allow read: if true; // Dibaca publik oleh katalog & pendaftaran
      allow write: if isManagement() || isStaff();
    }
    match /class_planning/{id} {
      allow read: if true;
      allow write: if isManagement() || isStaff();
    }
    match /class_availability/{id} {
      allow read: if isInternalTeam() || isMember();
      allow write: if isManagement() || isStaff();
    }
    match /mentors/{id} {
      allow read: if true; // Diubah jadi true agar form remedial & katalog publik bisa baca mentor
      allow write: if isManagement() || (isMentor() && isSelf(resource.data.get('user_id', '')));
    }
    match /mentor/{id} {
      allow read: if true; // Fallback koleksi nama tunggal
      allow write: if isManagement();
    }
    match /schedule_logs/{id} {
      allow read: if isInternalTeam();
      allow write: if isManagement() || isStaff();
    }
    match /promo_classes/{id} { allow read: if isInternalTeam() || isMember(); allow write: if isManagement(); }
    match /promo_batches/{id} { allow read: if isInternalTeam() || isMember(); allow write: if isManagement(); }
    match /webinars/{id} { allow read: if true; allow write: if isManagement(); }

    match /data_member/{id} {
      allow read: if true;
      allow write: if isManagement() || isStaff();
    }
    match /member_attendance/{id} {
      allow read, create: if true;
      allow update, delete: if isManagement() || isStaff();
    }
    match /certificate_logs/{id} {
      allow read, create, update: if true;
      allow delete: if isManagement() || isStaff();
    }
    match /subscription_email/{id} {
      allow read: if isManagement();
      allow create: if true;
      allow update, delete: if isManagement();
    }

    // remedial_reports: form pengajuan remedial dari dialogika.co/remedial.html
    match /remedial_reports/{id} {
      allow create: if true; // siswa publik boleh submit pengajuan remedial
      allow read: if isInternalTeam(); // hanya tim internal yang membaca/mengelola
      allow update, delete: if isManagement() || isStaff();
    }

    // -------------------------------------------------------------------
    // BRANDING, OFFICE & CMS
    // -------------------------------------------------------------------
    match /branding_content/{id} { allow read, write: if isInternalTeam(); }
    match /inventory/{id} {
      allow read: if isInternalTeam();
      allow write: if isManagement() || isStaff();
    }
    match /trash/{id} {
      allow read: if isManagement();
      allow write: if isManagement();
    }
    match /announcements/{id} {
      allow read: if isInternalTeam();
      allow write: if isManagement();
    }
    match /site_content/{id} {
      allow read: if true;
      allow write: if isManagement() || isStaff();
    }
    match /site_pages/{slug} {
      allow read: if resource.data.get('published', false) == true || isInternalTeam();
      allow write: if isManagement() || isStaff();
    }
    match /mentors_public/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /site_forms/{slug} {
      allow read: if true;
      allow write: if isManagement();
    }
    match /form_submissions/{id} {
      allow read: if isManagement();
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
